# App connection — Supabase TRANSACTION pooler (port 6543).
# pgbouncer=true is required or Prisma's prepared statements break.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"

# Migrations only — Supabase SESSION pooler (same host, port 5432).
# NOT db.<project-ref>.supabase.co: that host is IPv6-only and unreachable
# from most networks. Transaction mode can't run migrations, hence two URLs.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
PORT=4000
CORS_ORIGIN="http://127.0.0.1:5175,http://localhost:5175,http://127.0.0.1:5174,http://localhost:5174"
