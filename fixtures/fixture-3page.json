  "sections": [
    {
      "id": "s1",
      "type": "summary",
      "title": "Professional Summary",
      "order": 0,
      "visible": true,
      "items": [
        {
          "id": "i1",
          "order": 0,
          "visible": true,
          "text": "Principal engineer with fourteen years designing high-throughput distributed systems for payments, logistics, and telecommunications infrastructure across sub-Saharan Africa and Western Europe. Repeatedly hired to stabilise systems that had outgrown their original architecture, and to build the engineering practices that keep them stable afterwards. Comfortable operating from board-level technical strategy down to the profiler."
        }
      ]
    },
    {
      "id": "s2",
      "type": "experience",
      "title": "Experience",
      "order": 1,
      "visible": true,
      "items": [
        {
          "id": "i2",
          "order": 0,
          "visible": true,
          "role": "Principal Engineer, Platform",
          "organization": "Ndoro Infrastructure Group",
          "location": "Harare, ZW",
          "startDate": "2022-09",
          "endDate": "present",
          "summary": "Technical lead for the settlement platform processing interbank transfers for nine institutions.",
          "bullets": [
            { "id": "b1", "order": 0, "text": "Redesigned the settlement ledger from a single-writer Postgres instance to a partitioned append-only log with deterministic replay, lifting sustained throughput from 1,400 to 22,000 transactions per second while reducing p99 write latency from 840ms to 31ms." },
            { "id": "b2", "order": 1, "text": "Eliminated a class of double-settlement defects that had cost the business approximately $2.1M in manual reconciliation over three years." },
            { "id": "b3", "order": 2, "text": "Introduced deterministic replay testing across the settlement path, raising defect detection before release from 34% to 91%." },
            { "id": "b4", "order": 3, "text": "Mentored eleven engineers across three teams; four have since been promoted to senior or staff level." },
            { "id": "b5", "order": 4, "text": "Authored the platform's architectural decision record practice, now used by every team in the engineering organisation." },
            { "id": "b6", "order": 5, "text": "Negotiated a phased migration with three partner banks that avoided any settlement downtime during a fourteen-month cutover." }
          ]
        },
        {
          "id": "i3",
          "order": 1,
          "visible": true,
          "role": "Staff Software Engineer",
          "organization": "Meridian Logistics Systems",
          "location": "Amsterdam, NL",
          "startDate": "2019-03",
          "endDate": "2022-08",
          "summary": null,
          "bullets": [
            { "id": "b7", "order": 0, "text": "Built the routing optimisation service handling 180,000 daily consignments across eleven European distribution hubs." },
            { "id": "b8", "order": 1, "text": "Reduced average route computation time from 47 seconds to 2.3 seconds by replacing the constraint solver with a domain-specific heuristic and a warm-start cache." },
            { "id": "b9", "order": 2, "text": "Led the incident review practice after a nine-hour outage; the resulting changes reduced mean time to recovery by 62% over the following year." },
            { "id": "b10", "order": 3, "text": "Owned the service's SLO framework and error budget policy." },
            { "id": "b11", "order": 4, "text": "Represented engineering in quarterly planning with commercial and operations leadership." }
          ]
        },
        {
          "id": "i4",
          "order": 2,
          "visible": true,
          "role": "Senior Software Engineer",
          "organization": "Chiedza Telecommunications",
          "location": "Harare, ZW",
          "startDate": "2016-01",
          "endDate": "2019-02",
          "summary": null,
          "bullets": [
            { "id": "b12", "order": 0, "text": "Rebuilt the prepaid billing pipeline to process 40 million call detail records nightly within a four-hour window, down from an eleven-hour window that regularly overran into business hours." },
            { "id": "b13", "order": 1, "text": "Introduced schema migration tooling that removed the need for scheduled maintenance downtime." },
            { "id": "b14", "order": 2, "text": "Diagnosed and fixed a long-standing rounding defect that had under-billed roaming traffic by an estimated $340,000 annually." },
            { "id": "b15", "order": 3, "text": "Ran the internal engineering guild on data modelling for two years." }
          ]
        },
