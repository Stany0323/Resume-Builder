{
  "name": "resume-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @resume-builder/web",
    "dev:backend": "npm run dev --workspace @resume-builder/backend",
    "dev:render": "npm run dev --workspace @resume-builder/render",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:spike-a": "node scripts/spike-a-parity.mjs",
    "db:status": "npm run prisma:status --workspace @resume-builder/backend",
    "db:deploy": "npm run prisma:deploy --workspace @resume-builder/backend",
    "db:generate": "npm run prisma:generate --workspace @resume-builder/backend",
    "db:seed": "npm run prisma:seed --workspace @resume-builder/backend"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
